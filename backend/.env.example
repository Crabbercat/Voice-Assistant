APP_NAME=VietHome AI
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
DEBUG=true
MOCK_HARDWARE=true
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_INPUT_DEVICE=
AUDIO_BLOCK_SECONDS=0.25
AUDIO_SILENCE_THRESHOLD=0.005
WAKE_WORDS=hey berry,hey barry,hey beri,hey very,hey be ri
WAKE_CHUNK_SECONDS=3
WAKE_DETECTION_INTERVAL_SECONDS=1
WAKE_WORD_COOLDOWN_SECONDS=2
COMMAND_SILENCE_DURATION=1.2
COMMAND_MIN_DURATION=0.4
COMMAND_START_TIMEOUT_SECONDS=5
COMMAND_MAX_DURATION=15
VOICE_ENABLED=false
VOICE_AUTO_START=false
VOICE_AUTO_EXECUTE=false
VOICE_HISTORY_LIMIT=50
COMMAND_CATALOG_PATH=hardware/configs/commands.json
DATABASE_URL=sqlite+aiosqlite:///./viethome.db
API_PREFIX=/api/v1
COMMAND_SIMILARITY_THRESHOLD=80
STT_MODEL=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
STT_BEAM_SIZE=1
STT_VAD_FILTER=false
STT_MODEL_CACHE_DIR=models/whisper

