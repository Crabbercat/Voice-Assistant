APP_NAME=VietHome AI
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
DEBUG=true
MOCK_HARDWARE=true
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
DATABASE_URL=sqlite+aiosqlite:///./viethome.db
API_PREFIX=/api/v1
COMMAND_SIMILARITY_THRESHOLD=80
STT_MODEL=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=vi
STT_BEAM_SIZE=1
STT_MODEL_CACHE_DIR=models/whisper

